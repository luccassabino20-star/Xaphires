PORT=4000
# Opcional: caminho onde o banco SQLite e o segredo do JWT ficam salvos.
# Por padrao usa a pasta server/data dentro do projeto.
# KANBAN_DATA_DIR=server/data

# Defina como "production" no deploy. Faz o cookie de sessao exigir HTTPS (flag Secure).
# NODE_ENV=production

# Origem do frontend quando ele roda em um dominio diferente da API.
# Ativa CORS com credenciais e cookie sameSite=none.
# FRONTEND_URL=https://app.seudominio.com

# Origens extras autorizadas a enviar requisicoes de escrita (separadas por virgula).
# So e necessario se algo alem do proprio site consumir a API.
# ALLOWED_ORIGINS=https://outro.seudominio.com

# Defina quando a app roda atras de um proxy reverso (Nginx, Render, Railway...).
# Use o numero de saltos ate o cliente (normalmente 1) para que o limitador de
# tentativas enxergue o IP real em vez do IP do proxy.
# TRUST_PROXY=1

# Recomendado em producao: segredo fixo do JWT. Sem ele um e gerado em
# server/data/jwt-secret.txt, o que derruba as sessoes se o disco for efemero.
# JWT_SECRET=

# ---------- Cobranca ----------
# Provedor de pagamento. "fake" (padrao) simula tudo localmente e nao cobra nada.
# "asaas" usa a API real e exige as credenciais abaixo.
# BILLING_PROVIDER=fake

# Segredo que assina o webhook do provedor simulado, so para desenvolvimento.
# BILLING_WEBHOOK_SECRET=simulado

# Credencial do Asaas (chave da API, painel > Integracoes > API). Comece pela de
# SANDBOX: com a de producao, cada assinatura cobra de verdade no cartao de quem
# clicar.
# ASAAS_API_KEY=

# "sandbox" (padrao) ou "production" - escolhe entre api-sandbox.asaas.com e
# api.asaas.com. Fica separado da chave de proposito: e comum ter as duas
# credenciais anotadas e esquecer de trocar o ambiente junto.
# ASAAS_ENV=sandbox

# Token que o Asaas manda de volta em todo webhook, no cabecalho
# asaas-access-token (painel > Integracoes > Webhooks - se nao informado na
# criacao, o proprio Asaas gera um e mostra so uma vez). Sem ele a validacao
# recusa todo aviso de proposito, e nenhum pagamento e confirmado pelo webhook.
# ASAAS_WEBHOOK_TOKEN=
